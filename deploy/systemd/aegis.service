[Unit]
Description=Aegis AI Data Supply Gateway
After=network.target

[Service]
Type=simple
User=aegis
Group=aegis
WorkingDirectory=/opt/aegis
EnvironmentFile=-/etc/aegis/aegis.env
ExecStart=/usr/local/bin/aegis -config /etc/aegis/config.local.json
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aegis /var/log/aegis

[Install]
WantedBy=multi-user.target
